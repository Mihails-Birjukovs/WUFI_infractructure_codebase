       RowBox[{"{", "}"}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"projectSummary", " ", "=", " ", 
     RowBox[{"Map", "[", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"<|", "\n", "    ", 
         RowBox[{
          RowBox[{"\"\<Project\>\"", " ", "->", " ", 
           RowBox[{"Lookup", "[", 
            RowBox[{"#", ",", " ", "\"\<ProjectFileName\>\""}], "]"}]}], ",", 
          "\n", "    ", 
          RowBox[{"\"\<Cases\>\"", " ", "->", " ", 
           RowBox[{"Lookup", "[", 
