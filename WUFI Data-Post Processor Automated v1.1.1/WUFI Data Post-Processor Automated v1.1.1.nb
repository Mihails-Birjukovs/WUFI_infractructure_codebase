Notebook[{

Cell[CellGroupData[{
Cell["WUFI Data Post-Processor Automated", "Title",ExpressionUUID->"f1398a6c-90d2-44ce-82a0-1aef343d2f31"],

Cell["Production Version v1.1.1", "Subtitle",ExpressionUUID->"97270343-e410-4a63-881e-473f1d470f98"],

Cell["\<\
Manifest-driven WUFI ASC post-processing for Mathematica 12.1. Production \
v1.1.1 retains fresh graphics-kernel isolation per case and adds bounded \
validated graphics parallelism, deterministic time-series ticks, \
controller-side progress, stage timings, robust kernel-launch accounting, \
atomic exports, truthful retry diagnostics, and restart of incomplete cases \
while preserving the Production v1.0 Batch Launcher manifest contract and the \
WUFI VS Sensor Comparison v1.2.0 WXF contract.\
\>", "Text",ExpressionUUID->"f7a7b995-2ef7-4276-a0f8-9b87253f6410"],

Cell[CellGroupData[{

Cell["1. Load Production v1.1.1", "Section",ExpressionUUID->"221208a8-39c1-45bd-964c-27ebe5226825"],

Cell["\<\
Keep this notebook, WUFIDataPostProcessor_v1_1_1.wl, \
WUFIDataPostProcessorConfig_v1_1_1.wl, and the existing WUFIModelMetadata.wl \
together. Full mode additionally needs the existing LIM Curves folder beside \
them. Sweep mode does not load LIM curves. The validated production-default \
graphics pool is 8 kernels; 12 is the validated high-throughput option. \
Counts above 12 are not recommended; a 16-kernel reference run failed.\
\>", "Text",ExpressionUUID->"7deed7cc-e20a-443a-a8b0-4d39243eb668"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Get", "@", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      "\"\<WUFIDataPostProcessor_v1_1_1.wl\>\""}], "}"}], "]"}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Get", "@", 
  RowBox[{"FileNameJoin", "[", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"NotebookDirectory", "[", "]"}], ",", "\[IndentingNewLine]", 
     "\"\<WUFIDataPostProcessorConfig_v1_1_1.wl\>\""}], "\[IndentingNewLine]",
     "}"}], "]"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.995396975919629*^9, 3.995396981706793*^9}, {
  3.995823011248827*^9, 3.9958230139644947`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"90190fdc-67c7-49ea-beab-9cce6d3e4f29"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Preflight", "Section",ExpressionUUID->"2eda1dc1-2078-498b-a4b8-d7ef34c74925"],

Cell["\<\
Preflight resolves the unchanged Batch Launcher manifest, optionally \
identifies already-complete cases in restart mode, checks requested ASC \
files, validates Windows path constraints (including atomic-export temporary \
paths), and requires LIM curves only in Full mode.\
\>", "Text",ExpressionUUID->"a22cd9b6-b5fa-4fb7-8be1-7bcf7e460f7b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"postProcessorPreflight", "=", 
    RowBox[{"PreflightWUFIPostProcessorV11", "@", "postProcessorSettings"}]}],
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", "@", 
  RowBox[{"KeyTake", "[", "\[IndentingNewLine]", 
   RowBox[{"postProcessorPreflight", ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<Status\>\"", ",", "\"\<Version\>\"", ",", "\"\<GraphicsMode\>\"", 
      ",", "\"\<RestartFailedCases\>\"", ",", "\"\<ReadyProjectCount\>\"", 
      ",", "\"\<ManifestCaseCount\>\"", ",", "\"\<RequestedCaseCount\>\"", 
      ",", "\"\<SkippedCompleteCaseCount\>\"", ",", "\"\<MissingASCCount\>\"",
       ",", "\"\<LIMCurves\>\"", ",", "\"\<Warnings\>\"", ",", 
      "\"\<Errors\>\""}], "}"}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.995189569078876*^9, 3.995189577076017*^9}, {
  3.995189639951337*^9, 3.995189667826623*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"6ff8ce24-4b7f-41fb-9c65-d2f63223803b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Run post-processing", "Section",ExpressionUUID->"27c6c18c-0d16-432e-a1bd-d689d44e2379"],

Cell["\<\
WXFs are exported and validated before graphics. Graphics are constructed and \
exported inside a fresh bounded subkernel pool for each case; Graphics \
expressions are not returned to the controller kernel. Production v1.1.1 \
reports stage milestones and a controller-side graphics progress indicator, \
records requested/launched kernel counts and stage timings, and preserves the \
true last failure stage across retries. A case is marked Processed only after \
all outputs required by the selected GraphicsMode validate successfully.\
\>", "Text",ExpressionUUID->"9dc240d4-ec4c-40c5-99b2-69da0770acae"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"postProcessingRun", "=", 
    RowBox[{"RunWUFIPostProcessorV11", "@", "postProcessorSettings"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", "@", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{"KeyTake", "[", "\[IndentingNewLine]", 
    RowBox[{"postProcessingRun", ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
      "\"\<Status\>\"", ",", "\"\<GraphicsMode\>\"", ",", 
       "\"\<ProcessingTimeSeconds\>\"", ",", "\"\<RequestedCaseCount\>\"", 
       ",", "\"\<ProcessableCaseCount\>\"", ",", 
       "\"\<SkippedCompleteCaseCount\>\"", ",", "\"\<MissingASCCount\>\"", 
       ",", "\"\<CompletedCaseCount\>\"", ",", "\"\<FailedCaseCount\>\"", 
       ",", "\"\<OutputRoot\>\"", ",", "\"\<PostprocessManifest\>\""}], 
      "}"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
   "}"}]}]}], "Input",
 CellChangeTimes->{{3.9951896611386404`*^9, 3.995189688739422*^9}, 
   3.9955266449004664`*^9},
 CellLabel->"In[5]:=",ExpressionUUID->"edcf5160-d081-4dbb-a8a6-a799006d523d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Restart incomplete/failed cases", "Section",ExpressionUUID->"1c9a5747-c7c5-468c-8aad-f67e59c7efd4"],

Cell["\<\
Use this after an interrupted run or after any failed image/WXF validation. \
The restart audits the actual output tree, skips complete cases, and within \
incomplete cases keeps already-valid files. It does not rely solely on the \
checkpoint manifest, so it can recover after a hard kernel or application \
failure.\
\>", "Text",ExpressionUUID->"3c149431-95e7-4cb1-8f16-bd4fb99d287c"],

Cell[BoxData[
 RowBox[{"postProcessingRun", "=", 
  RowBox[{
  "RestartFailedWUFIPostProcessorCasesV11", "@", 
   "postProcessorSettings"}]}]], "Input",
 CellChangeTimes->{{3.9958232231533203`*^9, 
  3.9958232243036127`*^9}},ExpressionUUID->"734ae786-515e-4c9f-ad72-\
fb6111f8afb7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Audit current outputs without processing", "Section",ExpressionUUID->"d9f305d5-921a-4bc9-aec0-df8f2ede2a89"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"postProcessorAudit", "=", 
   RowBox[{
   "AuditWUFIPostProcessorOutputsV11", "@", "postProcessorSettings"}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", "@", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{"KeyTake", "[", "\[IndentingNewLine]", 
    RowBox[{"postProcessorAudit", ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
      "\"\<Version\>\"", ",", "\"\<GraphicsMode\>\"", ",", 
       "\"\<CaseCount\>\"", ",", "\"\<CompleteCaseCount\>\"", ",", 
       "\"\<IncompleteCaseCount\>\""}], "}"}]}], "\[IndentingNewLine]", "]"}],
    "\[IndentingNewLine]", "}"}]}]}], "Input",
 CellChangeTimes->{{3.995189827557505*^9, 3.9951898440582747`*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"cf89b771-b28a-4807-a236-51eec0490402"]
}, Open  ]],

Cell[CellGroupData[{

Cell["GraphicsMode contract", "Section",ExpressionUUID->"51dc0942-2ea4-4021-ad94-07ecfba8be3f"],

Cell["\<\
Full reproduces the v1.0 graphics inventory: humidity, temperature, dew \
point, mould history, mould risk, per-layer water content, and total \
construction water content. Sweep always writes all five WXF time-series \
files but generates only humidity and temperature sensor plots plus per-layer \
and total water-content plots. Thus Sweep is downstream-compatible with the \
sensor-comparison framework while substantially reducing graphics-engine load.\
\>", "Text",ExpressionUUID->"f93b9487-caeb-46de-8632-eed7fbe179a4"]
}, Open  ]]
}, Open  ]]
},
