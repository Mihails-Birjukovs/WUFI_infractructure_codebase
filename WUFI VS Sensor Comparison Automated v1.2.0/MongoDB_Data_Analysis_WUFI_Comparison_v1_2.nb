Notebook[{

Cell[CellGroupData[{
Cell["\<\
MongoDB Sensor Data Analysis & WUFI Comparison - Production v1.2.0\
\>", "Title",
 CellChangeTimes->{{3.9944474252906446`*^9, 3.994447454217034*^9}, 
   3.994447950225449*^9, {3.9944504606507125`*^9, 3.994450460904837*^9}, {
   3.994454553558905*^9, 3.9944545536620893`*^9}, {3.994459564248949*^9, 
   3.9944595643270793`*^9}, 3.994460424341033*^9, 3.994698591653684*^9, 
   3.9946991955088835`*^9},ExpressionUUID->"9467f618-55be-4566-bb51-\
ec7eb2006530"],

Cell["\<\
Optimized companion framework with cached wall/grid sensor preparation, \
single-pass UTC normalization, parallel graphics task batches, per-case \
subkernel recycling, checked raster export, and complete graphics audits. \
Production launcher/post-processor v1 remain untouched.\
\>", "Text",ExpressionUUID->"e4e5839a-1fc8-4683-9a8e-84576463f73a"],

Cell[CellGroupData[{

Cell["1. Load the Production v1.2.0 driver", "Section",ExpressionUUID->"9b6e0c6f-66d4-4040-bde7-1066d586cc0f"],

Cell["\<\
Edit SensorComparisonConfig_v1_2.wl first when the input folders are not \
beside this notebook.\
\>", "Text",ExpressionUUID->"0686d404-67a9-4ba2-b198-202a4495649c"],

Cell[BoxData[
 RowBox[{"Get", "@", 
  RowBox[{"FileNameJoin", "[", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"NotebookDirectory", "[", "]"}], ",", 
     "\"\<MongoDB_Data_Analysis_WUFI_Comparison_v1_2.wl\>\""}], "}"}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9944442646909413`*^9, 3.9944442694441147`*^9}, {
  3.995556202316416*^9, 3.9955562034969373`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"76754299-5ba6-4a02-bfee-17754ca35e46"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Preflight", "Section",ExpressionUUID->"ba1b83b3-637b-4092-ac6f-b6c9683e3a8d"],

Cell["\<\
Preflight validates the sensor registry, LIM files, selected-sensor WXF \
directory, 
Production Run root, WUFI manifest, and explicit case selection.\
\>", "Text",
 CellChangeTimes->{
  3.9944443032923765`*^9},ExpressionUUID->"60e75720-5f7e-4535-8b38-\
9019227d2d94"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sensorComparisonPreflight", "=", 
   RowBox[{"SensorComparisonPreflight", "@", "sensorComparisonSettings"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"sensorComparisonPreflight", "[", "\"\<Status\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "sensorComparisonPreflight", "[", "\"\<ResolvedSelections\>\"", "]"}], "//",
   "Length"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sensorComparisonPreflight", "[", "\"\<OutputPathAudit\>\"", "]"}], 
  "[", "\"\<PlannedPathCount\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"sensorComparisonPreflight", "[", "\"\<Warnings\>\"", "]"}], "\n", 
 RowBox[{"sensorComparisonPreflight", "[", "\"\<Errors\>\"", "]"}]}], "Input",
 CellChangeTimes->{{3.9944442737574043`*^9, 3.9944442750838346`*^9}, {
  3.994446606672538*^9, 3.9944466208351307`*^9}, {3.9955569147214403`*^9, 
  3.9955569232497993`*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"ff645295-fd75-46b0-9773-a8a8fb500c6c"],

Cell["\<\
The compact view below keeps the Ready/Blocked state and any errors visible. 
Inspect sensorComparisonPreflight[\"Settings\"] separately for the complete \
resolved paths.\
\>", "Text",
 CellChangeTimes->{
  3.994444306210455*^9},ExpressionUUID->"5b284e5d-020d-4555-b378-\
c29f1d4ad959"],

Cell[BoxData[
 RowBox[{"Dataset", "@", 
  RowBox[{
  "sensorComparisonPreflight", "[", "\"\<Settings\>\"", "]"}]}]], "Input",
 CellChangeTimes->{{3.9949575448652086`*^9, 3.994957573976256*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"509e171a-3a5a-4ba6-9e0d-8836d22d2053"],

Cell[BoxData[
 RowBox[{"Dataset", "@", 
  RowBox[{"KeyTake", "[", "\[IndentingNewLine]", 
   RowBox[{"sensorComparisonPreflight", ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<Status\>\"", ",", "\"\<RegistrySensorCount\>\"", ",", 
      "\"\<LIMCurveNames\>\"", ",", "\"\<ResolvedSelections\>\"", ",", 
      "\"\<Warnings\>\"", ",", "\"\<Errors\>\""}], "}"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.99444427931787*^9, 3.994444286195796*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"bbbf78ab-d9ef-4529-8a57-8572c085792e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Optional one-time JSON to MX cache generation", "Section",ExpressionUUID->"0f7cc175-2c62-4f21-94be-b2511ebf633e"],

Cell["\<\
Do not evaluate during routine analysis. 
Extract the archival JSON from the supplied 7z first, then use this once 
to regenerate the MX cache and provenance sidecar.\
\>", "Text",
 CellChangeTimes->{{3.9944443121551037`*^9, 
  3.9944443162606134`*^9}},ExpressionUUID->"9d415f4e-4f90-44ba-9c63-\
4f5e1076e0b2"],

Cell[BoxData[
 RowBox[{"BuildMXCacheFromJSON", "@", 
  RowBox[{"Join", "[", 
   RowBox[{"sensorComparisonSettings", ",", 
    RowBox[{"<|", 
     RowBox[{"\"\<InputMode\>\"", "->", "\"\<JSON\>\""}], "|>"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.994444292729305*^9, 
  3.994444293482424*^9}},ExpressionUUID->"daebaf9e-35de-479c-aaa6-\
15ba2b7374a8"]
}, Closed]],

Cell[CellGroupData[{

Cell["4. Optional selected-sensor WXF regeneration from MX", "Section",ExpressionUUID->"40e561ff-1c5a-48b6-8d93-943b4e19b040"],

Cell["\<\
Evaluate only when the canonical registry or raw extraction logic changes. 
Routine comparisons import the existing selected sensor WXFs directly.\
\>", "Text",
 CellChangeTimes->{
  3.994444297613287*^9},ExpressionUUID->"153b06d3-9b12-4869-8506-\
9ec8a63879d4"],

Cell[BoxData[
 RowBox[{"RegenerateSelectedSensorWXFs", "@", 
  RowBox[{"Join", "[", 
   RowBox[{"sensorComparisonSettings", ",", 
    RowBox[{"<|", 
     RowBox[{"\"\<InputMode\>\"", "->", "\"\<MX\>\""}], "|>"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.994444382052374*^9, 
  3.99444438308395*^9}},ExpressionUUID->"865af245-f95d-472c-bf2b-\
73e2167cb425"]
}, Closed]],

Cell[CellGroupData[{

Cell["5. Run sensor analysis and selected WUFI comparisons", "Section",ExpressionUUID->"e84313d2-6b18-4fdd-b8d4-fa500495316b"],

Cell["\<\
Only timestamps with valid sensor estimates are paired. 
Missing intervals are never filled. 
Selected cases are controlled in SensorComparisonConfig_v1_2.wl.\
\>", "Text",
 CellChangeTimes->{{3.9944443208264685`*^9, 
  3.994444322342575*^9}},ExpressionUUID->"a2952b99-1307-4c6c-b512-\
af16b1b34e54"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"comparisonResult", "=", 
    RowBox[{"RunSensorComparison", "@", "sensorComparisonSettings"}]}], ";"}],
   "//", "AbsoluteTiming"}], "\n", 
 RowBox[{"Dataset", "@", 
  RowBox[{"KeyDrop", "[", 
   RowBox[{"comparisonResult", ",", 
    RowBox[{"{", "\"\<RunResults\>\"", "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9944443768924494`*^9, 3.994444379259166*^9}, {
   3.9944530492019696`*^9, 3.9944530506000485`*^9}, 3.9949326195119143`*^9},
 CellLabel->"In[10]:=",ExpressionUUID->"a9c89196-9b7f-48a1-815e-30a359fe6076"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"SystemOpen", "@", 
   RowBox[{"Lookup", "[", 
    RowBox[{"comparisonResult", ",", "\"\<OutputRoot\>\""}], "]"}]}], 
  "*)"}]], "Input",
 CellChangeTimes->{{3.994444374861692*^9, 3.9944443757475824`*^9}, 
   3.99445531616579*^9},
 CellLabel->"In[68]:=",ExpressionUUID->"6bd73d68-1a32-4ae0-982d-2dd8d8ab4e0e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Change selected WUFI cases without changing code", "Section",ExpressionUUID->"42e16372-d027-4f90-a0b4-21e86cab7046"],

Cell["\<\
Example: compare all four reference-material hypotheses against the \
reference-wall measurements while omitting hempcrete.\
\>", "Text",ExpressionUUID->"c000f624-bc97-4fc2-a65f-52f71d4d97fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sensorComparisonSettings", "=", 
   RowBox[{"Join", "[", "\[IndentingNewLine]", 
    RowBox[{"sensorComparisonSettings", ",", 
     RowBox[{"<|", 
      RowBox[{"\"\<SelectedCases\>\"", "->", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
        "\"\<Wall_REF_60-40_filling\>\"", ",", "\[IndentingNewLine]", 
         "\"\<Wall_REF_1GR\>\"", ",", "\[IndentingNewLine]", 
         "\"\<Wall_REF_3GR\>\"", ",", "\[IndentingNewLine]", 
         "\"\<Wall_REF_CGR\>\""}], "\[IndentingNewLine]", "}"}]}], "|>"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.994444330237029*^9, 3.994444358123389*^9}, {
  3.9944555553341618`*^9, 
  3.994455556255044*^9}},ExpressionUUID->"09172c11-640d-4295-bae4-\
83f9247d2c92"]
}, Closed]],

Cell[CellGroupData[{

Cell["7. Aggregation-method sensitivity examples", "Section",ExpressionUUID->"1b16dfb3-a8fa-4eaf-b63a-022d71cc3351"],

Cell["\<\
Available methods: CenteredWindowMedian, CenteredWindowMean, \
CenteredWindowWinsorizedMean, RightClosedHourlyMedian, and \
PointInterpolation. PointInterpolation refuses brackets wider than the \
configured limit.\
\>", "Text",ExpressionUUID->"577fa95a-3d0a-48e2-84b7-40b3da6b7e1f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sensorComparisonSettings", "=", 
   RowBox[{"Join", "[", "\[IndentingNewLine]", 
    RowBox[{"sensorComparisonSettings", ",", 
     RowBox[{"<|", 
      RowBox[{
      "\"\<AggregationMethod\>\"", "->", "\"\<CenteredWindowMedian\>\""}], 
      "|>"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.99444436412286*^9, 
  3.9944443655398026`*^9}},ExpressionUUID->"8939243c-8fc8-4a17-b427-\
4effcab4b0c3"]
}, Closed]],

Cell[CellGroupData[{

Cell["8. Optional compute-only and deferred plot rendering", "Section",ExpressionUUID->"5a9002b7-d421-4e00-9546-6ac4a096b084"],

Cell["\<\
For profiling or restartable workflows, set ExecutionProfile to ComputeOnly. \
The run still writes metrics, CSV summaries, manifests, and WXF bundles, but \
skips JPG rendering. RenderExistingComparisonOutput later regenerates all \
sensor-only and comparison plots from those WXF bundles.\
\>", "Text",ExpressionUUID->"370f1f99-1a83-47fc-8a81-2587cee9f415"],

Cell[BoxData[
 RowBox[{
  RowBox[{"computeOnlySettings", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"sensorComparisonSettings", ",", 
     RowBox[{"<|", 
      RowBox[{"\"\<ExecutionProfile\>\"", "->", "\"\<ComputeOnly\>\""}], 
      "|>"}]}], "]"}]}], ";"}]], "Input",ExpressionUUID->"bdb7a20e-14b9-4021-\
9af9-bd1d77fe528b"],

Cell[BoxData[
 RowBox[{"computeOnlyResult", "=", 
  RowBox[{"RunSensorComparison", "@", "computeOnlySettings"}]}]], "Input",Expr\
essionUUID->"905a7a25-7de3-4f51-9880-5d0b61218461"],

Cell[BoxData[
 RowBox[{"RenderExistingComparisonOutput", "[", 
  RowBox[{
   RowBox[{"Lookup", "[", 
    RowBox[{"computeOnlyResult", ",", "\"\<OutputRoot\>\""}], "]"}], ",", 
   "sensorComparisonSettings"}], "]"}]], "Input",ExpressionUUID->"bcf65b07-\
2656-498c-8097-6c016cb9b61e"]
}, Closed]]
}, Open  ]]
},
